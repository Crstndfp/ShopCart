# ============================================================================
# ShopCart Environment Configuration (.env.example)
# ============================================================================

# Application Environment
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# Microsoft SQL Server Database Connection
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=ShopCartDB
DB_USER=sa
DB_PASSWORD=PentandraShopCart2026!
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
DB_POOL_MIN=5
DB_POOL_MAX=25

# JWT Authentication & Rotation Secrets
JWT_ACCESS_SECRET=shopcart_super_secret_access_jwt_key_2026_min_32_chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=shopcart_super_secret_refresh_jwt_key_2026_min_32_chars
JWT_REFRESH_EXPIRATION_DAYS=7

# Background Worker Settings
BACKGROUND_RESERVATION_CLEANUP_CRON=* * * * *
CART_ABANDONED_THRESHOLD_HOURS=24

# Security & CORS
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
